# KHILONA Backend Environment Variables
# Port assigned by Render or local dev (defaults to 8000)
PORT=8000

# Allowed frontend origin for CORS in production (e.g., https://khilona.vercel.app)
# Multiple origins can be comma-separated: https://khilona.vercel.app,https://khilona-preview.vercel.app
# Localhost origins (5173, 3000, 4173) are always allowed.
FRONTEND_ORIGIN=

# Optional: custom model directory path (defaults to <repo_root>/model)
# MODEL_DIR=

